{
  "name": "gopher-fit-front",
  "main": "index.tsx",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "storybook": "npm run storybook-generate && EXPO_PUBLIC_ENVIRONMENT=storybook expo start",
    "storybook-generate": "sb-rn-get-stories",
    "gen:api": "openapi-typescript ../gopher-fit-back/docs/openapi.json --output lib/api-schema.ts --default-non-nullable false",
    "check:api": "npm run gen:api -- --check",
    "typecheck": "npm run check:api && tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "build:web": "expo export --platform web",
    "preview:web": "node scripts/serve-web.cjs",
    "test:integration": "node tests/live-api.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/elements": "2.9.5",
    "@react-navigation/native": "^7.1.8",
    "@tamagui/config": "^1.144.3",
    "@tamagui/core": "^1.144.3",
    "expo": "~54.0.37",
    "expo-constants": "~18.0.14",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "jiti": "^2.6.1",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@gorhom/bottom-sheet": "^5.2.6",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/slider": "5.0.1",
    "@storybook/addon-ondevice-actions": "^10.0.2",
    "@storybook/addon-ondevice-controls": "^10.0.2",
    "@storybook/react-native": "^10.0.2",
    "@types/react": "~19.1.17",
    "babel-loader": "^8.4.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "3.7.4",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-svg": "^15.12.1",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "19.1.0",
    "storybook": "^10.0.7",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.1"
  },
  "private": true
}
